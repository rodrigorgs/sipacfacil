{
  "manifest_version": 3,
  "name": "Consulta de Processo SIPAC UFBA",
  "description": "Adiciona uma consulta rápida de protocolo ao portal público do SIPAC/UFBA.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["https://sipac.ufba.br/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://sipac.ufba.br/*"]
    }
  ],
  "host_permissions": ["https://sipac.ufba.br/*"]
}
